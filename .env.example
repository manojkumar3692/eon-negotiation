# Next.js merchant dashboard. All values here are server-side.
APP_ORIGIN=http://127.0.0.1:3000
NEON_BRANCH=dashboard-onboarding
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Generate a random secret of at least 32 characters; never commit it.
NEON_AUTH_COOKIE_SECRET=

# Customer conversation intent extraction. AI never authorizes prices.
OPENAI_API_KEY=
OPENAI_MODEL=
# Keep false until a connector passes catalog, context and checkout staging.
NEGOTIATION_ENABLED=false

# Future adapters: provision only when their implementation is ready.
# OAuth app secrets remain server-only. Merchant tokens belong in encrypted
# installation records, never in one shared global token or browser storage.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
CONNECTOR_ENCRYPTION_KEY=
SESSION_SIGNING_SECRET=
